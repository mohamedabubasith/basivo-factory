# Copy to .env and fill in. Keep .env private: it holds the keys to everything the dashboard connects to.

# Public HTTPS address of the dashboard. GitHub and Jira send events here, so it must be reachable by them.
APP_URL=https://factory.example.com

# GitHub logins allowed to sign in, comma-separated.
ADMIN_GITHUB_LOGINS=your-github-login

# Long random strings; generate each with:  openssl rand -hex 32
# FACTORY_SECRET encrypts the stored tokens: if it changes or is lost, reconnect Jira, Claude and GitHub.
FACTORY_SECRET=
POSTGRES_PASSWORD=

# Port on this server; put the company HTTPS proxy in front of it.
DASHBOARD_PORT=3000
